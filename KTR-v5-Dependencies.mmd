%% Solid arrow  = direct package reference (each layer pins only the Kelly package directly below it, KTR0006;
%%                the host and every ribbon module pin Kelly.Revit.UI)
%% Thick arrow  = run-time load, not a package reference
flowchart TB
    subgraph APP["Kelly-Revit-v5 &middot; add-in"]
        direction LR
        HOST["<b>Kelly.Revit</b> host<br/>App &middot; EventService &middot; RibbonService"]
        MODS["<b>Ribbon modules</b> &middot; one DLL per tab<br/>All &middot; Pipe &middot; Duct &middot; Contenter &middot; Manager &middot; Developer<br/><i>+ ExcelDataReader, Serilog</i>"]
        HOST ==>|"loads at run time"| MODS
    end
    NOTE["<b>Note:</b> RibbonService loads each module at startup <b>only if its DLL is<br/>present in the add-in's application directory</b>. A missing DLL means no tab;<br/>a module that fails is reported and never stops the add-in or the others."]
    MODS ~~~ NOTE

    UI["<b>Kelly.Revit.UI</b> &middot; Revit layer<br/>ribbon / command / MVVM framework<br/><i>+ Telerik WPF</i>"]
    LOGIC["<b>Kelly.Revit.Logic</b> &middot; Revit layer<br/>Revit API logic (Revit API compile-only)<br/><i>+ CsvHelper</i>"]

    DOMAIN["<b>Kelly.Domain</b> &middot; Revit-free<br/>domain types<br/><i>+ Newtonsoft.Json</i>"]
    WIN["<b>Kelly.Windows</b> &middot; Revit-free<br/>WPF / Windows helpers<br/><i>+ Serilog, CsvHelper, ObjectsComparer, ...</i>"]
    DATA["<b>Kelly.Windows.Data</b> &middot; Revit-free<br/>data access<br/><i>+ Dapper, Microsoft.Data.SqlClient, Newtonsoft.Json</i>"]

    %% Direct package references
    APP --> UI
    UI --> LOGIC
    LOGIC --> DOMAIN
    DOMAIN --> WIN
    WIN --> DATA

    classDef layer fill:#eef4ff,stroke:#3b6fd8,color:#111
    classDef module fill:#fff4e0,stroke:#d8901b,color:#111
    classDef note fill:#fffbe6,stroke:#b8a000,stroke-dasharray:4 3,color:#333
    class HOST,UI,LOGIC,DOMAIN,WIN,DATA layer
    class MODS module
    class NOTE note
    linkStyle 0 stroke:#d8901b,stroke-width:3px
