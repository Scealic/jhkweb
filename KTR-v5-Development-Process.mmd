---
title: Kelly Tools For Revit v5 - development process
config:
  flowchart:
    wrappingWidth: 420
---
%% One change, from backlog item to the installed add-in. The loop on the right runs once per layer,
%% bottom-up: Kelly-Windows-Data-v3 -> Kelly-Windows-v3 -> Kelly-Domain -> Kelly-Revit-Logic-v5 -> Kelly-Revit-UI -> Kelly-Revit-v5.
%% Sources: CLAUDE.md, BuildConfigs/SHARED-AGENTS.md.
flowchart TB
    START(["<b>Backlog item</b><br/>repo's Quick-Backlog.md &middot; To Organize"])
    LOW["<b>Pick the lowest layer</b> the change belongs in<br/><i>Revit-free code stays below Kelly-Revit-Logic;<br/>commands, Views, ViewModels stay in Kelly-Revit-v5</i>"]
    START --> LOW

    subgraph LAYER["Per layer &middot; on develop"]
        direction TB
        TEST["<b>Write a failing NUnit test</b> (TDD)<br/>Author = &quot;Verified By Human On:&quot; &middot; Description"]
        CODE["<b>Implement</b><br/>namespace matches folder &middot; DRY &middot; no secrets"]
        BUILD["<b>Build</b> with a configuration<br/>-p:GeneratePackageOnBuild=false"]
        KIND{"Which layer?"}
        WTEST["<b>dotnet test</b> in Net481, Net80 and Net100"]
        RPREP["<b>Prepare in-Revit run</b> (Revit 2024)<br/>close Revit / ricaun &middot; rename<br/>Kelly Tools For Revit 5.addin &rarr; .addin.x"]
        RTEST["<b>dotnet test</b> -c 2024<br/>ricaun starts Revit, runs, closes it"]
        RBACK["<b>Rename the manifest back</b><br/>(also after a failed or stopped run)"]
        LOG{"TestLogs .md: a row for every test,<br/>all passing, no Missing results?"}
        DOCS["<b>Docs in the same commit</b><br/>README (Running the tests, SOLID) &middot; Changelog<br/>(not yet in a package) &middot; XML docs &middot; tick Quick-Backlog"]
        COMMIT["<b>Commit and push develop</b><br/>no co-author trailer"]
        PACK["<b>Pack</b> &middot; GeneratePackageOnBuild<br/>version yy.M.d.HHmm &rarr; C:\Repo\NugetPackages<br/>Changelog heading gets the package version"]

        TEST --> CODE --> BUILD --> KIND
        KIND -->|"Windows-Data / Windows / Domain"| WTEST --> LOG
        KIND -->|"Revit-Logic / Revit-UI"| RPREP --> RTEST --> RBACK --> LOG
        LOG -->|"no: fix, or rerun missing<br/>fixtures with --filter"| CODE
        LOG -->|"yes"| DOCS --> COMMIT --> PACK
    end
    LOW --> TEST

    ABOVE{"Layer above is<br/>Kelly-Revit-v5?"}
    REPIN["<b>Repin the layer above</b><br/>one version in its Directory.Packages.props<br/><i>only the package directly below (KTR0006)</i>"]
    PACK --> ABOVE
    ABOVE -->|"no"| REPIN
    REPIN -->|"next layer up: rebuild, test, pack"| TEST

    subgraph ADDIN["Kelly-Revit-v5 &middot; the add-in"]
        direction TB
        APIN["<b>Repin Kelly.Revit.UI</b><br/>host and ribbon modules"]
        ABUILD["<b>Build</b> -c 2024 / 2025 / 2026<br/><i>root Directory.Build.targets blocks install: KTR0004</i>"]
        ATEST["<b>Tests.Revit</b> in Revit 2024<br/>AddInContractTests: commands, availability, icons"]
        INST{"Install on purpose?"}
        DOINST["<b>-p:InstallAddin=true</b><br/>&rarr; Kelly Tools For Revit\V5\&lt;year&gt;<br/>other versions' manifests renamed .addin.x"]
        NOTES["<b>Record it</b><br/>Changelog (version ...) &middot; Quick-Backlog evidence<br/>&middot; KTR release notes (v5 tab, repo tab)"]
        APIN --> ABUILD --> ATEST --> INST
        INST -->|"yes"| DOINST --> NOTES
        INST -->|"no: built, not installed"| NOTES
    end
    ABOVE -->|"yes"| APIN

    PR(["<b>develop &rarr; main pull request</b><br/>by the maintainer"])
    NOTES --> PR

    %% Blue = any layer, amber = needs Revit, purple = decision, green = start and end
    classDef step fill:#E6F1FB,stroke:#185FA5,color:#0C447C
    classDef revit fill:#FAEEDA,stroke:#854F0B,color:#633806
    classDef decide fill:#EEEDFE,stroke:#534AB7,color:#3C3489
    classDef term fill:#E1F5EE,stroke:#016043,color:#085041
    class LOW,TEST,CODE,BUILD,WTEST,DOCS,COMMIT,PACK,REPIN step
    class RPREP,RTEST,RBACK,APIN,ABUILD,ATEST,DOINST,NOTES revit
    class KIND,LOG,ABOVE,INST decide
    class START,PR term
